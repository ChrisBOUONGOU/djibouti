{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} | FDF{% endblock %}

{% block body %}
<header class="site-header">
    <a class="brand" href="{{ path('app_home') }}" aria-label="FDF — Accueil">
        <span class="brand-mark"><span>FDF</span></span>
        <span class="brand-copy"><strong>FÉDÉRATION DJIBOUTIENNE</strong><small>DE FOOTBALL</small></span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span><span></span><span class="sr-only">Ouvrir le menu</span>
    </button>
    <nav class="main-nav" id="main-nav" aria-label="Navigation principale">
        <a class="active" href="{{ path('app_home') }}">Accueil</a>
        <a href="#actualites">Actualités</a>
        <a href="#equipes">Équipes nationales</a>
        <a href="#competitions">Compétitions</a>
        <a href="#federation">La fédération</a>
        <a class="nav-cta" href="https://inside.fifa.com/associations/DJI" target="_blank" rel="noopener noreferrer">Profil FIFA ↗</a>
    </nav>
</header>

<main>
    <section class="hero">
        <div class="hero-image" role="img" aria-label="Joueurs de football sur un terrain"></div>
        <div class="hero-shade"></div>
        <div class="hero-content wrap">
            <p class="eyebrow"><span></span> BRAVOURE · DYNAMISME · EXPLOIT</p>
            <h1>Le football<br>nous <em>rassemble.</em></h1>
            <p class="hero-intro">Au service du football djiboutien, de ses talents et de la prochaine génération.</p>
            <div class="hero-actions">
                <a class="button button-light" href="#actualites">Découvrir les actualités <span>↗</span></a>
                <a class="text-link" href="#federation">Découvrir la FDF <span>→</span></a>
            </div>
        </div>
        <div class="hero-label"><span>DJI</span><span class="label-line"></span><span>FOOTBALL</span></div>
    </section>

    <section class="quick-strip" aria-label="Accès rapides">
        <a href="#actualites"><span class="quick-number">01</span><span><strong>Actualités</strong><small>La vie du football</small></span><b>↗</b></a>
        <a href="#equipes"><span class="quick-number">02</span><span><strong>Nos équipes</strong><small>Porter les couleurs</small></span><b>↗</b></a>
        <a href="#competitions"><span class="quick-number">03</span><span><strong>Compétitions</strong><small>Le jeu en action</small></span><b>↗</b></a>
    </section>

    <section class="section wrap" id="actualites">
        <div class="section-heading">
            <div><p class="eyebrow eyebrow-dark">AU CŒUR DU JEU</p><h2>Les dernières <em>actualités</em></h2></div>
            <a class="underlined-link" href="https://fdf.dj/" target="_blank" rel="noopener noreferrer">Toutes les actualités <span>↗</span></a>
        </div>
        <p class="section-note">Retrouvez les informations et les temps forts du football djiboutien. Les cartes ci-dessous sont des exemples de présentation à remplacer par les articles officiels.</p>
        <div class="news-grid">
            <article class="news-card news-featured">
                <a class="news-photo photo-one" href="https://fdf.dj/" target="_blank" rel="noopener noreferrer" aria-label="Consulter le site officiel de la FDF"><span class="photo-tag">FÉDÉRATION</span></a>
                <div class="news-copy"><p class="meta">VIE FÉDÉRALE <span>•</span> À LA UNE</p><h3>Faire grandir le football djiboutien, ensemble</h3><p>Les initiatives et les projets qui contribuent au développement du football dans le pays.</p><a class="arrow-link" href="https://fdf.dj/" target="_blank" rel="noopener noreferrer">Lire sur le site officiel <span>↗</span></a></div>
            </article>
            <article class="news-card">
                <a class="news-photo photo-two" href="#equipes" aria-label="Découvrir les équipes nationales"><span class="photo-tag">ÉQUIPES</span></a>
                <div class="news-copy"><p class="meta">ÉQUIPES NATIONALES</p><h3>Les couleurs nationales, une fierté à partager</h3><p>Suivez les sélections et les talents qui représentent Djibouti.</p><a class="arrow-link" href="#equipes">Découvrir les équipes <span>→</span></a></div>
            </article>
            <article class="news-card">
                <a class="news-photo photo-three" href="#competitions" aria-label="Découvrir les compétitions"><span class="photo-tag">COMPÉTITIONS</span></a>
                <div class="news-copy"><p class="meta">FOOTBALL LOCAL</p><h3>Un football qui se construit sur le terrain</h3><p>Compétitions, clubs et initiatives : le football vit à tous les niveaux.</p><a class="arrow-link" href="#competitions">Voir les compétitions <span>→</span></a></div>
            </article>
        </div>
    </section>

    <section class="national-section" id="equipes">
        <div class="national-image"></div><div class="national-overlay"></div>
        <div class="national-content wrap"><p class="eyebrow">UN PAYS · UNE PASSION</p><h2>Fiers de porter<br>les couleurs de <em>Djibouti.</em></h2><p>Des équipes nationales aux jeunes talents, chaque génération contribue à écrire la suite de notre histoire footballistique.</p><a class="button button-outline" href="https://inside.fifa.com/associations/DJI" target="_blank" rel="noopener noreferrer">Découvrir Djibouti à la FIFA <span>↗</span></a></div>
        <div class="national-watermark">DJI</div>
    </section>

    <section class="section wrap competitions-section" id="competitions">
        <div class="section-heading">
            <div><p class="eyebrow eyebrow-dark">SUR TOUS LES TERRAINS</p><h2>Le football <em>en action</em></h2></div>
        </div>
        <div class="competition-list">
            <a href="https://fdf.dj/" target="_blank" rel="noopener noreferrer"><span class="comp-index">01</span><span class="comp-icon">◉</span><span class="comp-copy"><strong>Championnat national</strong><small>Le football des clubs djiboutiens</small></span><span class="comp-arrow">↗</span></a>
            <a href="https://fdf.dj/" target="_blank" rel="noopener noreferrer"><span class="comp-index">02</span><span class="comp-icon">◇</span><span class="comp-copy"><strong>Coupe nationale</strong><small>La passion du football à élimination directe</small></span><span class="comp-arrow">↗</span></a>
            <a href="https://inside.fifa.com/associations/DJI" target="_blank" rel="noopener noreferrer"><span class="comp-index">03</span><span class="comp-icon">✳</span><span class="comp-copy"><strong>Compétitions internationales</strong><small>Djibouti sur la scène africaine et mondiale</small></span><span class="comp-arrow">↗</span></a>
        </div>
    </section>

    <section class="federation-section" id="federation">
        <div class="wrap federation-grid">
            <div><p class="eyebrow eyebrow-dark">À PROPOS DE LA FDF</p><h2>Une fédération.<br><em>Une ambition.</em></h2></div>
            <div class="federation-copy"><p>La Fédération Djiboutienne de Football œuvre au développement et à la structuration du football à Djibouti, en accompagnant les clubs, les équipes et les acteurs du jeu.</p><a class="underlined-link" href="https://fdf.dj/" target="_blank" rel="noopener noreferrer">Visiter le site officiel <span>↗</span></a></div>
        </div>
    </section>
</main>

<footer class="site-footer">
    <div class="wrap footer-main">
        <a class="brand brand-footer" href="{{ path('app_home') }}"><span class="brand-mark"><span>FDF</span></span><span class="brand-copy"><strong>FÉDÉRATION DJIBOUTIENNE</strong><small>DE FOOTBALL</small></span></a>
        <div class="footer-motto">BRAVOURE <span>·</span> DYNAMISME <span>·</span> EXPLOIT</div>
        <div class="footer-contact"><strong>CONTACT</strong><span>Centre Technique National, Quartier 6</span><span>B.P. 2694, Djibouti</span><a href="mailto:federationfootballfdf1979@gmail.com">federationfootballfdf1979@gmail.com</a><a href="tel:+25321353599">+253 21 35 35 99</a></div>
    </div>
    <div class="footer-bottom"><div class="wrap"><span>© {{ "now"|date("Y") }} FDF — Concept de refonte non officiel.</span><a href="https://fdf.dj/" target="_blank" rel="noopener noreferrer">Site officiel actuel ↗</a></div></div>
</footer>
{% endblock %}
